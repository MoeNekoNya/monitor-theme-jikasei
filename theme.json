{
  "name": "jikasei",
  "short": "jikasei",
  "description": "Jikasei — Vue 3 实时服务器监控主题，提供总览、单机详情、历史曲线与多种卡片布局。",
  "version": "2.0.0",
  "author": "MoeNekoNya",
  "url": "https://github.com/MoeNekoNya/monitor-theme-jikasei",
  "config": [
    {
      "type": "title",
      "label": "卡片与列表"
    },
    {
      "type": "select",
      "key": "cardStyle",
      "label": "默认卡片布局",
      "default": "detailed",
      "options": [
        {
          "value": "classic",
          "label": "经典"
        },
        {
          "value": "plain",
          "label": "简约"
        },
        {
          "value": "latency",
          "label": "延迟"
        },
        {
          "value": "detailed",
          "label": "详细"
        },
        {
          "value": "wide",
          "label": "宽卡"
        },
        {
          "value": "compact",
          "label": "紧凑列表"
        }
      ]
    },
    {
      "type": "boolean",
      "key": "showSmallCharts",
      "label": "卡片网络小图",
      "default": true,
      "help": "仅使用 /api/servers 已返回的 ping / loss 窗口数据。"
    },
    {
      "type": "title",
      "label": "颜色"
    },
    {
      "type": "select",
      "key": "accent",
      "label": "强调色",
      "default": "blue",
      "options": [
        {
          "value": "blue",
          "label": "蓝色"
        },
        {
          "value": "violet",
          "label": "紫色"
        },
        {
          "value": "green",
          "label": "绿色"
        },
        {
          "value": "orange",
          "label": "橙色"
        }
      ]
    }
  ]
}
